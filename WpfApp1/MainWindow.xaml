<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Почтовое отделение"
        Height="900" Width="1480" MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="86" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="6" Background="White" VerticalAlignment="Center">
                        <TextBlock Text="&#xE715;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="ПОЧТА" Foreground="White" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="Отделение № 150000" Foreground="#9FC2E8" FontSize="10.5" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,6,0,10">
                        <TextBlock Text="РАБОТА" Foreground="#7FA9D8" FontSize="10" FontWeight="SemiBold" Margin="24,12,0,6" />
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Главная" Uid="dashboard" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavShipments" Style="{StaticResource NavButton}" Tag="&#xE715;" Content="Отправления" Uid="shipments" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavProducts" Style="{StaticResource NavButton}" Tag="&#xE719;" Content="Почтовые товары" Uid="products" Checked="Nav_Checked" />
                        <TextBlock Text="СПРАВОЧНИКИ" Foreground="#7FA9D8" FontSize="10" FontWeight="SemiBold" Margin="24,18,0,6" />
                        <RadioButton x:Name="NavClients" Style="{StaticResource NavButton}" Tag="&#xE77B;" Content="Клиенты" Uid="clients" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavTariffs" Style="{StaticResource NavButton}" Tag="&#xE8EC;" Content="Тарифы" Uid="tariffs" Checked="Nav_Checked" />
                        <TextBlock Text="АНАЛИТИКА" Foreground="#7FA9D8" FontSize="10" FontWeight="SemiBold" Margin="24,18,0,6" />
                        <RadioButton x:Name="NavReports" Style="{StaticResource NavButton}" Tag="&#xE9D2;" Content="Отчёты" Uid="reports" Checked="Nav_Checked" />
                        <TextBlock Text="СИСТЕМА" Foreground="#7FA9D8" FontSize="10" FontWeight="SemiBold" Margin="24,18,0,6" />
                        <RadioButton x:Name="NavUsers" Style="{StaticResource NavButton}" Tag="&#xE716;" Content="Сотрудники" Uid="users" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavApi" Style="{StaticResource NavButton}" Tag="&#xE774;" Content="REST API" Uid="api" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavTests" Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="Тестирование" Uid="tests" Checked="Nav_Checked" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="#34537D" BorderThickness="0,1,0,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#2C5387">
                            <TextBlock x:Name="AvatarText" Text="А" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText" Text="Сотрудник" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="UserRoleText" Text="Оператор" Foreground="#9FC2E8" FontSize="10.5" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                Width="30" Height="30" Style="{StaticResource GhostButton}" Foreground="#C8D9EF" BorderThickness="0"
                                Padding="0" ToolTip="Выйти из учётной записи" Click="Logout_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E7EEF8" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Главная" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="PageSubtitle" Text="Обзор работы отделения" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="ApiBadge" Background="#E7F7F0" CornerRadius="4" Padding="12,6" VerticalAlignment="Center"
                                Cursor="Hand" MouseLeftButtonUp="ApiBadge_MouseLeftButtonUp">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ApiDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ApiText" Text="API онлайн · 5080" Foreground="#1E7A55" FontSize="11.5" FontWeight="SemiBold" Margin="7,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Width="1" Height="28" Background="{StaticResource BorderBrush}" Margin="16,0" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="DateText" Text="31 октября 2026" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" />
                            <TextBlock Text="рабочая смена 09:00–19:00" Style="{StaticResource MutedText}" FontSize="10.5" HorizontalAlignment="Right" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="ContentHost" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
