<UserControl x:Class="WpfApp1.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource Card}" Padding="16,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="3" Background="{Binding IconForeground, ElementName=Root}" CornerRadius="1" Margin="0,2,12,2" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Value, ElementName=Root}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,2" />
                <TextBlock Text="{Binding Hint, ElementName=Root}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Icon, ElementName=Root}" FontFamily="{StaticResource IconFont}" FontSize="18"
                       Foreground="{Binding IconForeground, ElementName=Root}" VerticalAlignment="Top" Margin="8,2,0,0" Opacity="0.85" />
        </Grid>
    </Border>
</UserControl>
