<UserControl x:Class="WpfApp1.Views.ShipmentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="230" Margin="0,0,10,0">
                        <TextBlock Text="ПОИСК" Style="{StaticResource CaptionText}" Margin="0,0,0,5" />
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBox}" KeyDown="SearchBox_KeyDown" ToolTip="Номер отправления, ФИО отправителя или получателя" />
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,10,0">
                        <TextBlock Text="СТАТУС" Style="{StaticResource CaptionText}" Margin="0,0,0,5" />
                        <ComboBox x:Name="StatusFilter" SelectionChanged="Filter_Changed" />
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,10,0">
                        <TextBlock Text="С ДАТЫ" Style="{StaticResource CaptionText}" Margin="0,0,0,5" />
                        <DatePicker x:Name="FromDate" SelectedDateChanged="Filter_Changed" />
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,10,0">
                        <TextBlock Text="ПО ДАТУ" Style="{StaticResource CaptionText}" Margin="0,0,0,5" />
                        <DatePicker x:Name="ToDate" SelectedDateChanged="Filter_Changed" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button Content="Найти" Style="{StaticResource SecondaryButton}" Click="Search_Click" />
                        <Button Content="Сброс" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Reset_Click" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Экспорт CSV" Style="{StaticResource GhostButton}" Click="Export_Click" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Click="Refresh_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Обновить" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Content="+  Новое отправление" Style="{StaticResource AccentButton}" Click="New_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="ShipmentsGrid" Margin="6,4" SelectionChanged="ShipmentsGrid_SelectionChanged"
                              MouseDoubleClick="ShipmentsGrid_MouseDoubleClick" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="126" />
                            <DataGridTemplateColumn Header="Тип" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding TypeImage, Converter={StaticResource ImagePath}}" Width="24" Height="24" Stretch="Uniform" />
                                            <TextBlock Text="{Binding TypeName}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Отправитель → получатель" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding SenderName}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding RecipientName}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAtText}" Width="90" />
                            <DataGridTextColumn Header="Стоимость" Binding="{Binding CostText}" Width="86" />
                            <DataGridTemplateColumn Header="Статус" Width="116">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadge}" Background="{Binding Status, Converter={StaticResource StatusBg}}">
                                            <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Background="#F8FAFD" CornerRadius="0,0,12,12" Padding="18,10">
                        <TextBlock x:Name="FooterText" Text="Загрузка…" Style="{StaticResource MutedText}" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid x:Name="EmptyPanel" VerticalAlignment="Center" Margin="24">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="70" Height="70" CornerRadius="6" Background="#EEF4FC" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE715;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="#93B5DE"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Выберите отправление" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4" />
                            <TextBlock Text="В таблице слева, чтобы увидеть карточку, историю статусов и операции."
                                       Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="DetailPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Border Background="#F4F8FE" CornerRadius="4,4,0,0" Padding="18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="62" Height="62" CornerRadius="4" Background="White" ClipToBounds="True">
                                            <Image x:Name="DetailImage" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="DetailNumber" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <Border x:Name="DetailStatusBorder" Style="{StaticResource StatusBadge}" Margin="0,6,0,0">
                                                <TextBlock x:Name="DetailStatusText" FontSize="11.5" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="DetailType" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="18,14,18,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ОТПРАВИТЕЛЬ" Style="{StaticResource CaptionText}" />
                                        <TextBlock x:Name="DetailSender" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <TextBlock x:Name="DetailSenderAddress" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Width="24" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="#9AB2CC" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="ПОЛУЧАТЕЛЬ" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="DetailRecipient" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock x:Name="DetailRecipientAddress" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ВЕС" Style="{StaticResource CaptionText}" />
                                        <TextBlock x:Name="DetailWeight" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="СТОИМОСТЬ" Style="{StaticResource CaptionText}" />
                                        <TextBlock x:Name="DetailCost" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="ДАТА ОФОРМЛЕНИЯ" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="DetailDate" FontSize="12.5" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="ОПЕРАТОР" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="DetailEmployee" FontSize="12.5" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="КОММЕНТАРИЙ" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="DetailComment" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14" />

                                <TextBlock Text="ИЗМЕНИТЬ СТАТУС" Style="{StaticResource CaptionText}" />
                                <ComboBox x:Name="StatusCombo" Margin="0,6,0,0" />
                                <TextBox x:Name="StatusComment" Style="{StaticResource InputTextBox}" Margin="0,8,0,0" Height="34" ToolTip="Комментарий к изменению статуса" />
                                <Button Content="Сохранить статус" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="SaveStatus_Click" />

                                <TextBlock Text="ИСТОРИЯ СТАТУСОВ" Style="{StaticResource CaptionText}" Margin="0,16,0,6" />
                                <ItemsControl x:Name="HistoryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ChangedAtText}" Style="{StaticResource MutedText}" FontSize="10.5" />
                                                    <TextBlock Text="{Binding EmployeeName}" Style="{StaticResource MutedText}" FontSize="10.5" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Редактировать" Style="{StaticResource SecondaryButton}" Click="Edit_Click" />
                                    <Button x:Name="DeleteButton" Grid.Column="2" Content="Удалить" Style="{StaticResource DangerButton}" Click="Delete_Click" Visibility="Collapsed" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
