<Window x:Class="WpfApp1.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — Почтовое отделение"
        Height="660" Width="1060"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="White" FontFamily="{StaticResource AppFont}">
    <Border BorderBrush="#DCE6F2" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="510" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}" MouseLeftButtonDown="LeftPanel_MouseLeftButtonDown">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="44,0">
                        <Border Width="54" Height="54" CornerRadius="6" Background="#FFFFFF" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE715;" FontFamily="{StaticResource IconFont}" FontSize="25" Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="ПОЧТОВОЕ ОТДЕЛЕНИЕ" Foreground="#C7D3E4" FontSize="12" FontWeight="Bold" Margin="0,22,0,8" />
                        <TextBlock Text="Информационно-справочная система" Foreground="White" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="32" />
                        <Border Height="1" Background="#3C5B87" Margin="0,20,0,18" />
                        <TextBlock Text="Учёт отправлений, клиентов, тарифов и почтовых товаров в едином рабочем месте оператора."
                                   Foreground="#B9C6D9" FontSize="13" TextWrapping="Wrap" LineHeight="21" />
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <TextBlock Text="MS SQL Server" Foreground="#8FA6C4" FontSize="11.5" Margin="0,0,14,0" />
                            <TextBlock Text="WPF · C#" Foreground="#8FA6C4" FontSize="11.5" Margin="0,0,14,0" />
                            <TextBlock Text="REST API" Foreground="#8FA6C4" FontSize="11.5" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Button x:Name="CloseButton" Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="12"
                        Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                        Style="{StaticResource GhostButton}" Padding="0" Click="Close_Click" ToolTip="Закрыть" />
                <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#E8F0FB" CornerRadius="4" Padding="10,5" HorizontalAlignment="Left">
                        <TextBlock Text="ИС «Почтовое отделение»" Foreground="{StaticResource PrimaryBrush}" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="Вход в систему" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,16,0,6" />
                    <TextBlock Text="Введите учётные данные сотрудника отделения" Style="{StaticResource MutedText}" Margin="0,0,0,26" />

                    <TextBlock Text="Логин" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="LoginBox" Style="{StaticResource InputTextBox}" Height="42" Text="admin" />

                    <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordBox}" Height="42" />

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentBrush}" FontSize="12.5" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="Collapsed" />

                    <Button Content="Войти" Style="{StaticResource PrimaryButton}" Height="44" Margin="0,20,0,0" Click="Login_Click" IsDefault="True" />

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="ДЕМО-ДОСТУП" Style="{StaticResource CaptionText}" Margin="10,0" />
                        <Border Grid.Column="2" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Tag="admin" Click="Demo_Click" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Администратор" FontSize="11.5" FontWeight="SemiBold" />
                                <TextBlock Text="admin" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Tag="operator" Click="Demo_Click" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Оператор" FontSize="11.5" FontWeight="SemiBold" />
                                <TextBlock Text="operator" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="© 2026 Ярославский градостроительный колледж · Курсовой проект"
                               Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Center" Margin="0,34,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
