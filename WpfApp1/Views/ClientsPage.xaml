<UserControl x:Class="WpfApp1.Views.ClientsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="300" Margin="0,0,10,0">
                        <TextBlock Text="ПОИСК ПО КЛИЕНТАМ" Style="{StaticResource CaptionText}" Margin="0,0,0,5" />
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBox}" KeyDown="SearchBox_KeyDown"
                                 ToolTip="ФИО, телефон или адрес" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button Content="Найти" Style="{StaticResource SecondaryButton}" Click="Search_Click" />
                        <Button Content="Сброс" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Reset_Click" />
                    </StackPanel>
                </StackPanel>
                <Button Content="+  Добавить клиента" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Add_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid x:Name="ClientsGrid" Margin="6,4" MouseDoubleClick="ClientsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*" />
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150" />
                        <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="2.4*" />
                        <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*" />
                        <DataGridTextColumn Header="В справочнике с" Binding="{Binding CreatedAtText}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Background="#F8FAFD" CornerRadius="0,0,12,12" Padding="18,12">
                    <Grid>
                        <TextBlock x:Name="FooterText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Редактировать" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" Click="Edit_Click" />
                            <Button x:Name="DeleteButton" Content="Удалить" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Delete_Click" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
