<Window x:Class="WpfApp1.Views.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="720" Width="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" FontFamily="{StaticResource AppFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,0,16">
            <TextBlock x:Name="TitleText" Text="Новый товар" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Карточка товара с изображением для каталога отделения" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="НАИМЕНОВАНИЕ" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" Style="{StaticResource InputTextBox}" MaxLength="120" />

                        <TextBlock Text="КАТЕГОРИЯ" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                        <ComboBox x:Name="CategoryCombo" IsEditable="True" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ЦЕНА, ₽" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PriceBox" Style="{StaticResource InputTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="КОЛИЧЕСТВО НА СКЛАДЕ" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="StockBox" Style="{StaticResource InputTextBox}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="ОПИСАНИЕ" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                        <TextBox x:Name="DescriptionBox" Style="{StaticResource InputTextArea}" MaxLength="400" />

                        <CheckBox x:Name="ActiveCheck" Content="Товар доступен для продажи" Margin="0,16,0,0" IsChecked="True" FontSize="13" />

                        <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentBrush}" FontSize="12.5" TextWrapping="Wrap"
                                   Margin="0,12,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="ИЗОБРАЖЕНИЕ ТОВАРА" Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                        <Border Height="210" CornerRadius="4" Background="#F2F7FD" ClipToBounds="True">
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                        </Border>
                        <Button Content="Выбрать изображение…" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Click="ChooseImage_Click" />
                        <TextBlock x:Name="ImageNameText" Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#EEF5FF" CornerRadius="4" Padding="12" Margin="0,14,0,0">
                    <TextBlock Text="Поддерживаются PNG, JPG и JPEG. Файл копируется в папку Assets/Images и становится доступен через API."
                               Foreground="#29405F" FontSize="11" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource GhostButton}" Width="120" Click="Cancel_Click" />
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Width="150" Margin="10,0,0,0" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
