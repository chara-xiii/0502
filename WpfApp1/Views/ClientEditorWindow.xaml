<Window x:Class="WpfApp1.Views.ClientEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клиент" Height="520" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" FontFamily="{StaticResource AppFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,0,18">
            <TextBlock x:Name="TitleText" Text="Новый клиент" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Сведения об отправителе или получателе" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
            <StackPanel>
                <TextBlock Text="ФИО" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="FullNameBox" Style="{StaticResource InputTextBox}" MaxLength="150" />

                <TextBlock Text="ТЕЛЕФОН" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                <TextBox x:Name="PhoneBox" Style="{StaticResource InputTextBox}" MaxLength="20" ToolTip="Формат: +7XXXXXXXXXX" />

                <TextBlock Text="АДРЕС" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                <TextBox x:Name="AddressBox" Style="{StaticResource InputTextBox}" MaxLength="250" />

                <TextBlock Text="E-MAIL (НЕОБЯЗАТЕЛЬНО)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                <TextBox x:Name="EmailBox" Style="{StaticResource InputTextBox}" MaxLength="100" />

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentBrush}" FontSize="12.5" TextWrapping="Wrap"
                           Margin="0,12,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource GhostButton}" Width="120" Click="Cancel_Click" />
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Width="150" Margin="10,0,0,0" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
