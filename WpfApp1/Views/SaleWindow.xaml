<Window x:Class="WpfApp1.Views.SaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Продажа товара" Height="650" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" FontFamily="{StaticResource AppFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,0,12">
            <TextBlock Text="Продажа почтового товара" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Оформление розничной продажи на кассовом окне" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Height="150" CornerRadius="4,4,0,0" Background="#F2F7FD" ClipToBounds="True">
                        <Image x:Name="ProductImage" Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="18">
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="CategoryText" Style="{StaticResource CaptionText}" />
                            <TextBlock x:Name="NameText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="PriceText" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock x:Name="DescriptionText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock x:Name="StockText" Style="{StaticResource MutedText}" Margin="0,6,0,0" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="КОЛИЧЕСТВО" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Button Content="−" Style="{StaticResource GhostButton}" Height="38" Padding="0" Click="Minus_Click" />
                                <TextBox x:Name="QuantityBox" Grid.Column="1" Style="{StaticResource InputTextBox}" Text="1" TextAlignment="Center"
                                         TextChanged="QuantityBox_TextChanged" />
                                <Button Grid.Column="2" Content="+" Style="{StaticResource GhostButton}" Height="38" Padding="0" Click="Plus_Click" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ПОКУПАТЕЛЬ" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ClientCombo" DisplayMemberPath="FullName" />
                        </StackPanel>
                    </Grid>

                    <Border Background="#EEF5FF" CornerRadius="4" Padding="14" Margin="0,18,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="ИТОГО К ОПЛАТЕ" Style="{StaticResource CaptionText}" />
                                <TextBlock x:Name="TotalText" Text="0,00 ₽" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="EmployeeText" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentBrush}" FontSize="12.5" TextWrapping="Wrap"
                               Margin="0,10,0,0" Visibility="Collapsed" />
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource GhostButton}" Width="120" Click="Cancel_Click" />
            <Button x:Name="SellButton" Content="Оформить продажу" Style="{StaticResource AccentButton}" Width="190" Margin="10,0,0,0" Click="Sell_Click" />
        </StackPanel>
    </Grid>
</Window>
