<UserControl x:Class="WpfApp1.Views.TariffsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Справочник тарифов" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Стоимость рассчитывается по первому подходящему действующему тарифу с достаточным максимальным весом."
                               Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="OperatorHint" Background="#FDF4E3" CornerRadius="4" Padding="12,7" Margin="0,0,10,0" Visibility="Collapsed">
                        <TextBlock Text="Изменение тарифов доступно администратору" Foreground="#8A5A12" FontSize="11.5" />
                    </Border>
                    <Button x:Name="AddButton" Content="+  Добавить тариф" Style="{StaticResource AccentButton}" Click="Add_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid x:Name="TariffsGrid" Margin="6,4" MouseDoubleClick="TariffsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Тип отправления" Binding="{Binding TypeName}" Width="*" />
                        <DataGridTextColumn Header="Максимальный вес" Binding="{Binding MaxWeightText}" Width="180" />
                        <DataGridTextColumn Header="Стоимость" Binding="{Binding PriceText}" Width="160" />
                        <DataGridTextColumn Header="Состояние" Binding="{Binding ActiveDisplay}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Background="#F8FAFD" CornerRadius="0,0,12,12" Padding="18,12">
                    <Grid>
                        <TextBlock x:Name="FooterText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Редактировать" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" Click="Edit_Click" />
                            <Button x:Name="ToggleButton" Content="Отключить / включить" Style="{StaticResource GhostButton}" Height="34" Padding="14,0" Margin="8,0,0,0" Click="Toggle_Click" />
                            <Button x:Name="DeleteButton" Content="Удалить" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Delete_Click" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
