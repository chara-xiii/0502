<Window x:Class="WpfApp1.Views.UserEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник" Height="650" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" FontFamily="{StaticResource AppFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,0,18">
            <TextBlock x:Name="TitleText" Text="Новый сотрудник" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Учётная запись для входа в приложение" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ФИО" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FullNameBox" Style="{StaticResource InputTextBox}" MaxLength="120" />

                    <TextBlock Text="ДОЛЖНОСТЬ" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <TextBox x:Name="PositionBox" Style="{StaticResource InputTextBox}" MaxLength="80" />

                    <TextBlock Text="ТЕЛЕФОН" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <TextBox x:Name="PhoneBox" Style="{StaticResource InputTextBox}" MaxLength="20" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ЛОГИН" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="LoginBox" Style="{StaticResource InputTextBox}" MaxLength="20" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="РОЛЬ" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="RoleCombo">
                                <ComboBoxItem Content="Оператор" Tag="Operator" />
                                <ComboBoxItem Content="Администратор" Tag="Admin" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="PasswordLabel" Text="ПАРОЛЬ" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <PasswordBox x:Name="PasswordBoxControl" Style="{StaticResource InputPasswordBox}" />
                    <TextBlock x:Name="PasswordHint" Text="Не менее 6 символов" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />

                    <CheckBox x:Name="ActiveCheck" Content="Учётная запись активна" Margin="0,16,0,0" IsChecked="True" FontSize="13" />

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentBrush}" FontSize="12.5" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource GhostButton}" Width="120" Click="Cancel_Click" />
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Width="150" Margin="10,0,0,0" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
