<UserControl x:Class="WpfApp1.Views.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WpfApp1.Controls"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="160" Margin="0,0,10,0">
                        <TextBlock Text="НАЧАЛО ПЕРИОДА" Style="{StaticResource CaptionText}" Margin="0,0,0,5" />
                        <DatePicker x:Name="FromDate" />
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,14,0">
                        <TextBlock Text="КОНЕЦ ПЕРИОДА" Style="{StaticResource CaptionText}" Margin="0,0,0,5" />
                        <DatePicker x:Name="ToDate" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Построить отчёт" Style="{StaticResource PrimaryButton}" Click="Build_Click" />
                        <Button Content="Экспорт CSV" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Export_Click" />
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="PeriodText" Text="" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                    <TextBlock Text="Данные формируются по текущему состоянию базы" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,16,0,0">
            <TabControl x:Name="ReportTabs" SelectionChanged="ReportTabs_SelectionChanged">
                <TabItem Header="Отправления">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:StatCard x:Name="ShipCountCard" Title="ОТПРАВЛЕНИЙ ЗА ПЕРИОД" Value="0" Hint="всего зарегистрировано" Icon="&#xE715;"
                                               IconBackground="#E8F0FB" IconForeground="{StaticResource PrimaryBrush}" />
                            <controls:StatCard x:Name="ShipTotalCard" Grid.Column="2" Title="СУММА ПО ОТПРАВЛЕНИЯМ" Value="0 ₽" Hint="по тарифам" Icon="&#xE8C7;"
                                               IconBackground="#E7F7F0" IconForeground="{StaticResource SuccessBrush}" />
                            <controls:StatCard x:Name="ShipAvgCard" Grid.Column="4" Title="СРЕДНЯЯ СТОИМОСТЬ" Value="0 ₽" Hint="на одно отправление" Icon="&#xE9D2;"
                                               IconBackground="#FDF4E3" IconForeground="{StaticResource WarningBrush}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="380" />
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <DataGrid x:Name="ShipmentReportGrid" Margin="4">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Тип отправления" Binding="{Binding Group}" Width="*" />
                                        <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="120" />
                                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalText}" Width="150" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Динамика по дням" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Количество отправлений (последние 14 дней периода)" Style="{StaticResource MutedText}" Margin="0,3,0,12" />
                                    <ItemsControl x:Name="ShipmentChart">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,0">
                                                    <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                                    <Grid Height="140">
                                                        <Border Height="{Binding BarHeight}" Width="18" CornerRadius="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                                Background="{StaticResource PrimaryLightBrush}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Label}" FontSize="9.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Продажи товаров">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:StatCard x:Name="SaleCountCard" Title="ПРОДАНО ЕДИНИЦ" Value="0" Hint="за выбранный период" Icon="&#xE719;"
                                               IconBackground="#E8F0FB" IconForeground="{StaticResource PrimaryBrush}" />
                            <controls:StatCard x:Name="SaleTotalCard" Grid.Column="2" Title="ВЫРУЧКА ОТ ТОВАРОВ" Value="0 ₽" Hint="сумма продаж" Icon="&#xE8C7;"
                                               IconBackground="#E7F7F0" IconForeground="{StaticResource SuccessBrush}" />
                            <controls:StatCard x:Name="SaleAvgCard" Grid.Column="4" Title="СРЕДНЯЯ ЦЕНА ЕДИНИЦЫ" Value="0 ₽" Hint="выручка / количество" Icon="&#xE9D2;"
                                               IconBackground="#FDECEE" IconForeground="{StaticResource AccentBrush}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="380" />
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <DataGrid x:Name="SalesReportGrid" Margin="4">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Товар" Binding="{Binding Group}" Width="*" />
                                        <DataGridTextColumn Header="Количество, шт." Binding="{Binding Count}" Width="150" />
                                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalText}" Width="150" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Динамика по дням" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Количество проданных единиц (последние 14 дней периода)" Style="{StaticResource MutedText}" Margin="0,3,0,12" />
                                    <ItemsControl x:Name="SalesChart">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,0">
                                                    <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                                    <Grid Height="140">
                                                        <Border Height="{Binding BarHeight}" Width="18" CornerRadius="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                                Background="{StaticResource AccentBrush}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Label}" FontSize="9.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
