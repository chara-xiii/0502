<UserControl x:Class="WpfApp1.Views.TestsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Автоматические проверки" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Тест-кейсы выполняются на текущей базе данных и проверяют тарифы, валидацию, авторизацию, JWT, целостность и отчётность."
                               Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0">
                    <Border x:Name="SummaryBadge" Background="#E8F0FB" CornerRadius="4" Padding="14,8" Margin="0,0,10,0">
                        <TextBlock x:Name="SummaryText" Text="Тесты не запущены" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Button x:Name="RunButton" Content="Запустить тесты" Style="{StaticResource AccentButton}" Click="Run_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid x:Name="ResultsGrid" Margin="6,4" RowHeight="52">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Тест-кейс" Binding="{Binding Name}" Width="2.2*" />
                        <DataGridTextColumn Header="Ожидаемый результат" Binding="{Binding Expected}" Width="1.5*" />
                        <DataGridTextColumn Header="Фактический результат" Binding="{Binding Actual}" Width="2*" />
                        <DataGridTemplateColumn Header="Статус" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="9,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FDECEE" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Passed}" Value="True">
                                                        <Setter Property="Background" Value="#E7F7F0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Passed}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Background="#F8FAFD" CornerRadius="0,0,12,12" Padding="18,12">
                    <Grid>
                        <TextBlock Text="Тестирование выполняется по методике «чёрного ящика»: проверяется результат выполнения операции."
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterText" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
