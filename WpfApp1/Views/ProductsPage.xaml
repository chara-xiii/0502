<UserControl x:Class="WpfApp1.Views.ProductsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="270" Margin="0,0,10,0">
                        <TextBlock Text="ПОИСК ТОВАРА" Style="{StaticResource CaptionText}" Margin="0,0,0,5" />
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBox}" KeyDown="SearchBox_KeyDown" />
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,10,0">
                        <TextBlock Text="КАТЕГОРИЯ" Style="{StaticResource CaptionText}" Margin="0,0,0,5" />
                        <ComboBox x:Name="CategoryCombo" SelectionChanged="Filter_Changed" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button Content="Найти" Style="{StaticResource SecondaryButton}" Click="Search_Click" />
                        <Button Content="Сброс" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Reset_Click" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="AddButton" Content="+  Добавить товар" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Add_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,16,0,0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ProductsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="232" Margin="7" Background="White" CornerRadius="4" BorderBrush="#E7EEF8" BorderThickness="1">
                                    <StackPanel>
                                        <Border Height="148" CornerRadius="4,4,0,0" Background="#F2F7FD" ClipToBounds="True">
                                            <Image Source="{Binding ImageFile, Converter={StaticResource ImagePath}}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Margin="14,12,14,14">
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource CaptionText}" FontSize="10.5" />
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" MinHeight="38" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" Height="30" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            <Grid Margin="0,8,0,0">
                                                <TextBlock Text="{Binding PriceText}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                                <TextBlock Text="{Binding StockText}" Style="{StaticResource MutedText}" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                            </Grid>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Content="Продать" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0"
                                                        Tag="{Binding}" Click="Sell_Click" IsEnabled="{Binding CanSell}" />
                                                <Button Grid.Column="1" Content="&#xE70F;" FontFamily="{StaticResource IconFont}" Style="{StaticResource GhostButton}"
                                                        Width="32" Height="32" Padding="0" Margin="6,0,0,0" Tag="{Binding}" Click="Edit_Click"
                                                        ToolTip="Редактировать товар"
                                                        Visibility="{Binding CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Text="Товары не найдены" Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="4,10,4,0">
            <TextBlock x:Name="FooterText" Style="{StaticResource MutedText}" />
            <TextBlock Text="Изображения товаров хранятся в папке Assets/Images и доступны через API."
                       Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</UserControl>
