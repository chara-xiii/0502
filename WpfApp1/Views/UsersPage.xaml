<UserControl x:Class="WpfApp1.Views.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Учётные записи сотрудников" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Администратор управляет справочником сотрудников, ролями и доступом к системе."
                               Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="+  Добавить сотрудника" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Add_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid x:Name="UsersGrid" Margin="6,4" MouseDoubleClick="UsersGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*" />
                        <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="1.3*" />
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150" />
                        <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="120" />
                        <DataGridTextColumn Header="Роль" Binding="{Binding RoleDisplay}" Width="140" />
                        <DataGridTextColumn Header="Состояние" Binding="{Binding ActiveDisplay}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Background="#F8FAFD" CornerRadius="0,0,12,12" Padding="18,12">
                    <Grid>
                        <TextBlock x:Name="FooterText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Редактировать" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0" Click="Edit_Click" />
                            <Button x:Name="BlockButton" Content="Заблокировать / разблокировать" Style="{StaticResource GhostButton}" Height="34" Padding="14,0" Margin="8,0,0,0" Click="Block_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
