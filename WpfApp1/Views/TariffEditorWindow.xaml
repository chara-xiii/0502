<Window x:Class="WpfApp1.Views.TariffEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тариф" Height="500" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" FontFamily="{StaticResource AppFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,0,18">
            <TextBlock x:Name="TitleText" Text="Новый тариф" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Тариф применяется при расчёте стоимости отправления" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
            <StackPanel>
                <TextBlock Text="ТИП ОТПРАВЛЕНИЯ" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="TypeCombo" DisplayMemberPath="Name" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="МАКСИМАЛЬНЫЙ ВЕС, КГ" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="WeightBox" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="СТОИМОСТЬ, ₽" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PriceBox" Style="{StaticResource InputTextBox}" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="ActiveCheck" Content="Тариф действует" Margin="0,18,0,0" IsChecked="True" FontSize="13" />

                <Border Background="#EEF5FF" CornerRadius="4" Padding="12" Margin="0,18,0,0">
                    <TextBlock Text="Для одного типа можно задать несколько тарифов с разным максимальным весом. При оформлении выбирается тариф с наименьшим подходящим весом."
                               Foreground="#29405F" FontSize="11.5" TextWrapping="Wrap" />
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentBrush}" FontSize="12.5" TextWrapping="Wrap"
                           Margin="0,12,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource GhostButton}" Width="120" Click="Cancel_Click" />
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Width="150" Margin="10,0,0,0" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
